# Copy to .env. Every key is optional; the defaults run the app locally with no external services.

# SQLite by default; use a postgresql://user:password@host:5432/dbname URL for Postgres
DATABASE_URL=sqlite:///./monitoring.db

# local | llm | hybrid  (see README: "How a prediction is made")
INFERENCE_MODE=local
HYBRID_CONFIDENCE_THRESHOLD=0.75
# Local decisions below this confidence come back as "uncertain" (unset = off). 0.7273 keeps 86.9% of
# validation predictions at 97% silver accuracy: artifacts/evaluation/abstain.json
# ABSTAIN_THRESHOLD=0.7273

# Only needed for INFERENCE_MODE=llm|hybrid and for /search-analysis
GROQ_API_KEY=
HF_TOKEN=

# docker compose only
POSTGRES_PASSWORD=

# Request limits (defaults shown). A CSV row can cost one LLM call in llm/hybrid mode,
# so uploads are capped lower there.
MAX_UPLOAD_BYTES=5000000
MAX_CSV_ROWS=1000
MAX_CSV_ROWS_LLM=100
MAX_TEXT_CHARS=2000
MAX_QUERY_CHARS=200

# Topic monitoring (see docs/IMPLEMENTATION_PLAN.md, Phase 3)
# The /api/v1/ingest endpoints stay disabled until this is set. Send it as the X-Ingest-Token header.
INGEST_TOKEN=
INGEST_INTERVAL_MIN=30
# Also the per-source cap on LLM calls when INFERENCE_MODE is llm or hybrid
MAX_POSTS_PER_RUN=100
POST_RETENTION_DAYS=90
# Optional extra https RSS feeds (comma-separated); entries are kept only if they mention the topic's query
RSS_FEEDS=

# LLM insights (themes, daily digest). Empty provider = groq if GROQ_API_KEY is set, otherwise off.
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_DAILY_TOKEN_BUDGET=200000
INSIGHT_INTERVAL_HOURS=6

# Agent sessions (need INGEST_TOKEN and an LLM). Each session is capped on all three.
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=20000
AGENT_TIMEOUT_SECONDS=90


# Hardening (see docs/DEPLOYMENT.md). 0 disables a rate limit.
API_AUTH=false
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_WRITE_PER_MINUTE=0
TRUST_PROXY=false
METRICS_TOKEN=
