# Copy to .env. Every key is optional; the defaults run the app locally with no external services.

# SQLite by default; use a postgresql://user:password@host:5432/dbname URL for Postgres
DATABASE_URL=sqlite:///./monitoring.db

# local | llm | hybrid  (see README: "How a prediction is made")
INFERENCE_MODE=local
HYBRID_CONFIDENCE_THRESHOLD=0.75

# Only needed for INFERENCE_MODE=llm|hybrid and for /search-analysis
GROQ_API_KEY=
HF_TOKEN=

# docker compose only
POSTGRES_PASSWORD=
